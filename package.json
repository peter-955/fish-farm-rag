{
  "name": "fish-farm-rag",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @ffr/api migration:run",
    "db:migration:generate": "pnpm --filter @ffr/api migration:generate",
    "codegen:rag-client": "pnpm --filter @ffr/api codegen:rag-client",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,yml,yaml,scss}": "prettier --write",
    "apps/rag/**/*.py": [
      "uv run --project apps/rag ruff check --fix",
      "uv run --project apps/rag ruff format"
    ]
  }
}
