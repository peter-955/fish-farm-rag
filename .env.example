# Copy to .env and edit. Never commit .env.

# --- Postgres (container) ---
POSTGRES_USER=ffr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ffr

# --- Ollama (native on the Mac mini) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
# Leave empty until the Phase 5 bake-off picks a local chat model.
LOCAL_CHAT_MODEL=

# --- Claude (optional; leave the key empty to run fully local) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
MONTHLY_LLM_BUDGET_USD=3

# --- Retrieval ---
RETRIEVAL_TOP_K=5

# DATABASE_URL / PG_CONN_STR / RAG_API_URL / DATA_DIR are derived by infra/compose.yml.
# When running apps on the host (pnpm dev), export for example:
#   DATABASE_URL=postgresql://ffr:change-me@127.0.0.1:5432/ffr   (needs compose.dev.yml)
